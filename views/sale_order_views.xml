<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_sale_order_form_custom" model="ir.ui.view">
        <field name="name">sale.order.form.custom</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='other_information']" position="after">
                <page string="Personalización" name="personalizacion">
                    <group col="12" class="mt-2 mt-md-0">
                        <group colspan="6">
                            <field name="mr_personalised_message" colspan="6" nolabel="1" placeholder="Mensaje personalizado para la cotización..."/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
